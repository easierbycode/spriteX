{
  "name": "evil-invaders-spritex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/main.ts --bundle --sourcemap --minify --format=esm --platform=browser --outdir=dist/assets --external:https://www.gstatic.com/*",
    "build:lib": "esbuild src/atlasManager.ts --bundle --sourcemap --minify --format=esm --platform=browser --outfile=dist/lib/index.js --external:https://www.gstatic.com/*",
    "build:plugin": "node scripts/build-plugin.mjs",
    "copy": "node scripts/copy-static.mjs",
    "build": "npm run build:web && npm run build:lib && npm run build:plugin && npm run copy",
    "download:atlas": "node scripts/download-atlas.mjs",
    "extract:frames": "node scripts/extract-frames.mjs",
    "optimize:atlas": "node scripts/optimize-atlas.mjs",
    "test": "node scripts/test-frame-keys.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.97",
    "@types/gif.js": "^0.2.5",
    "opentype.js": "^2.0.0",
    "zod": "^4.4.3"
  }
}
